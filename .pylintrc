[FORMAT]
# Default is 100; raised to 150 to match this project's style.
max-line-length=150

[BASIC]
# Default attr-rgx only allows snake_case; this allows an optional one or two
# leading underscores (protected/name-mangled attributes like self.__memory)
# while keeping everything else snake_case.
attr-rgx=^_{0,2}[a-z][a-z0-9_]*$

[TYPECHECK]
# googleapiclient.discovery.build() returns a Resource whose methods
# (.spreadsheets(), .values(), ...) are generated at runtime from the API
# discovery document, so pylint sees no attributes on it without this.
generated-members=googleapiclient.discovery.Resource.*
