#!/usr/bin/env bash
# Pre-commit hook: block the commit unless the unit test suite passes.
# Enabled via: git config core.hooksPath hooks

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RESET='\033[0m'

REPO_ROOT="$(git rev-parse --show-toplevel)"
PYTHON="$REPO_ROOT/.venv/bin/python"

if [ ! -x "$PYTHON" ]; then
    echo -e "${RED}pre-commit: virtualenv not found at .venv/bin/python - run:${RESET}"
    echo "  python -m venv .venv && .venv/bin/pip install -r requirements-dev.txt"
    exit 1
fi

echo -e "${YELLOW}pre-commit: running test suite...${RESET}"
if ! "$PYTHON" -m pytest "$REPO_ROOT/tests" -q; then
    echo ""
    echo -e "${RED}pre-commit: tests failed - commit aborted.${RESET}"
    exit 1
fi

echo -e "${GREEN}pre-commit: tests passed.${RESET}"
exit 0
