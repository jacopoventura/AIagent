#!/usr/bin/env bash
# Pre-commit hook: block the commit unless the unit tests pass and the pylint
# score for main.py/src/ is at least PYLINT_MIN_SCORE/10.
# Enabled via: git config core.hooksPath hooks

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RESET='\033[0m'

REPO_ROOT="$(git rev-parse --show-toplevel)"

# ── Privacy guard: personal data and secrets must never enter history ────────
# shellcheck source=hooks/privacy-guard.sh
source "$REPO_ROOT/hooks/privacy-guard.sh"
privacy_guard || exit 1
PYTHON="$REPO_ROOT/.venv/bin/python"
PYLINT_MIN_SCORE=8

if [ ! -x "$PYTHON" ]; then
    echo -e "${RED}pre-commit: virtualenv not found at .venv/bin/python - run:${RESET}"
    echo "  python -m venv .venv && .venv/bin/pip install -r requirements-dev.txt"
    exit 1
fi

echo -e "${YELLOW}pre-commit: running test suite...${RESET}"
if ! "$PYTHON" -m pytest "$REPO_ROOT/tests" -q; then
    echo ""
    echo -e "${RED}pre-commit: tests failed - commit aborted.${RESET}"
    exit 1
fi
echo -e "${GREEN}pre-commit: tests passed.${RESET}"

echo -e "${YELLOW}pre-commit: running pylint (minimum score: ${PYLINT_MIN_SCORE}/10)...${RESET}"
if ! "$PYTHON" -m pylint --fail-under="$PYLINT_MIN_SCORE" "$REPO_ROOT/main.py" "$REPO_ROOT/src"; then
    echo ""
    echo -e "${RED}pre-commit: pylint score below ${PYLINT_MIN_SCORE}/10 - commit aborted.${RESET}"
    exit 1
fi
echo -e "${GREEN}pre-commit: pylint score OK.${RESET}"

exit 0
